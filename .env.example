# Quip V3 — local environment
# Copy this file to `.env` and fill in your API keys.
#
# Never commit real keys. Keys stay in main process env only — never in
# frontend code, logs, or built files.
#
# Provider routing (V3 — GROQ FIRST):
#   When both keys exist, GROQ is the primary brain (fastest inference,
#   vision-capable llama-4 models). OpenRouter is the automatic fallback.
#   Change this in Settings → AI Brain (no restart needed) or here:
# QUIP_PRIMARY_PROVIDER=groq            ("groq" | "openrouter")
# QUIP_GROQ_ENABLED=1                   (0 = never dial Groq)
# QUIP_OPENROUTER_ENABLED=1             (0 = never dial OpenRouter)
#
# Get a free Groq key at:       https://console.groq.com/keys
# Get a free OpenRouter key at: https://openrouter.ai/keys

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Screen vision (the "look at my screen and click X" loop) runs on YOUR
# existing keys — no extra signup. Defaults are vision-capable models:
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct:free
