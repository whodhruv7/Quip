# Quip V2 — local environment
# Copy this file to `.env` and fill in your API keys.
#
# Never commit real keys. Keys stay in main process env only — never in
# frontend code, logs, or built files.
#
# Provider routing: Quip picks the FIRST configured provider.
# QUIP_PRIMARY_PROVIDER=openrouter   (optional: "openrouter" | "groq")
#
# Get a free OpenRouter key at: https://openrouter.ai/keys
# Get a free Groq key at:       https://console.groq.com/keys

OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: force the primary provider (default: auto — first configured)
# QUIP_PRIMARY_PROVIDER=openrouter
