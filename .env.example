# Quip V3 — local environment
# Copy this file to `.env` and fill in your API keys (or use Settings → AI Brain
# inside the app — keys saved there persist automatically, no restart needed).
#
# Never commit real keys. Keys stay in main process env only — never in
# frontend code, logs, or built files.
#
# ── Providers (V3 — FOUR-provider automatic failover chain) ─────────────────
# The chain is built from every provider that is enabled AND has a key.
# Priority: QUIP_PRIMARY_PROVIDER → Groq → Cerebras → NVIDIA → OpenRouter.
# If one provider fails (bad key, dead model, rate limit, network), Quip
# automatically tries the next one within the same message.
#
#   Groq  (free key):  https://console.groq.com/keys        keys start with gsk_
#   Cerebras (free):   https://cloud.cerebras.ai            keys start with csk-
#   NVIDIA  (free):    https://build.nvidia.com             keys start with nvapi-
#   OpenRouter(free):  https://openrouter.ai/keys           keys start with sk-or-
#
# QUIP_PRIMARY_PROVIDER=groq            ("groq" | "cerebras" | "nvidia" | "openrouter")
# QUIP_GROQ_ENABLED=1                   (0 = never dial Groq)
# QUIP_CEREBRAS_ENABLED=1               (0 = never dial Cerebras)
# QUIP_NVIDIA_ENABLED=1                 (0 = never dial NVIDIA)
# QUIP_OPENROUTER_ENABLED=1             (0 = never dial OpenRouter)
#
# Default models are verified live (2026-09-13). NOTE: Groq decommissioned
# llama-3.3-70b-versatile and llama-3.1-8b-instant for FREE tiers on
# 2026-08-16 — use the GPT-OSS models below (Quip also auto-falls-back to a
# spare model id when a provider rejects the configured one).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Screen vision (the "look at my screen and click X" loop) runs on YOUR
# existing keys — no extra signup. Defaults are vision-capable models:
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct:free

# Voice (Quip SPEAKS its replies): Groq neural voice first, the laptop's
# built-in Windows voice as offline fallback.
# QUIP_SPEAK_ENABLED=1                (0 = stay silent)
# QUIP_SPEAK_ENGINE=auto              ("auto" | "groq" | "local")
# GROQ_TTS_VOICE=Celeste-PlayAI
# QUIP_LOCAL_VOICE=                   (empty = Windows default voice)
