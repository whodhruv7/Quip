{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "../dist-test",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "../electron/engine/intent-parser-v2.ts",
    "../electron/engine/context-store.ts",
    "../electron/engine/permission-modes.ts",
    "../electron/engine/window-policy.ts",
    "../electron/engine/browser-automation.ts",
    "../electron/engine/orchestrator.ts",
    "../electron/engine/file-ops.ts",
    "../electron/engine/app-discovery.ts",
    "../electron/engine/system-control.ts",
    "../electron/engine/tool-registry.ts",
    "../electron/system/model-config.ts",
    "../electron/system/model-router.ts",
    "../electron/system/model-discovery.ts",
    "../electron/system/speech.ts",
    "../electron/system/env-store.ts",
    "../electron/system/provider-probe.ts",
    "../electron/window-geometry.ts",
    "../electron/brains/proactive-engine.ts",
    "../electron/brains/swarm-manager.ts",
    "../src/lib/companion-config.ts",
    "../src/lib/storage.ts",
    "../src/types/**/*.ts"
  ]
}
